{
  "name": "webmcp-litert-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:smoke": "playwright test",
    "test:webmcp": "RUN_NATIVE_WEBMCP=1 playwright test tests/native-webmcp.spec.ts --workers=1",
    "test:model": "RUN_REAL_MODEL=1 playwright test tests/real-model-evaluation.spec.ts --workers=1",
    "test:bonsai": "RUN_REAL_BONSAI=1 playwright test tests/real-bonsai-evaluation.spec.ts --workers=1 --headed",
    "test:litert": "RUN_REAL_LITERT=1 playwright test tests/real-litert-evaluation.spec.ts --workers=1 --headed",
    "benchmark:models": "npm run benchmark:models:v2",
    "benchmark:models:v2": "USE_CHROME_AI_PROFILE=1 RUN_MODEL_BENCHMARK=1 playwright test tests/model-benchmark.spec.ts --workers=1 --headed --reporter=list",
    "benchmark:chrome": "BENCHMARK_MODELS=chrome npm run benchmark:models:v2",
    "benchmark:litert-e4b": "BENCHMARK_MODELS=litert BENCHMARK_VARIANT=litert-e4b npm run benchmark:models:v2",
    "benchmark:bonsai-thinking": "BENCHMARK_MODELS=bonsai BENCHMARK_VARIANT=bonsai-thinking npm run benchmark:models:v2",
    "setup:chrome-ai-profile": "node scripts/chrome-ai-profile.mjs"
  },
  "dependencies": {
    "@litert-lm/core": "^0.15.0",
    "bitgpu": "^0.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.0.5"
  }
}
